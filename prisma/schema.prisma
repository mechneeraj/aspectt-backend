// ==============================================================================
// Aspectt OTT Platform - Prisma Database Schema
// Database: PostgreSQL
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. User Model
// ------------------------------------------------------------------------------
model User {
  id               String      @id
  name             String
  email            String      @unique
  passwordHash     String
  phone            String?
  avatar           String?
  avatarUrl        String      @default("https://api.dicebear.com/10.x/micah/svg?seed=Alex&backgroundColor=7E57C2")
  appLanguage      String      @default("en")
  subscriptionTier String      @default("FREE")
  createdAt        DateTime    @default(now())

  // Relations
  watchlist           Watchlist[]
  subscription        Subscription?
  subscriptionHistory SubscriptionHistory[]

  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. Movie Model
// ------------------------------------------------------------------------------
model Movie {
  id             String      @id
  title          String
  slug           String      @unique
  releaseYear    Int
  duration       String
  director       String
  description    String      @db.Text
  genres         String[]
  awardTag       String?
  directorsNote  String      @db.Text
  curatorsTake   String      @db.Text
  posterUrl      String      // 2:3 vertical aspect-poster image
  backdropUrl    String      // 16:9 horizontal landscape aspect-video backdrop
  videoStreamUrl String
  isHeroFeatured Boolean     @default(false)
  isCurated      Boolean     @default(false)
  createdAt      DateTime    @default(now())

  // Relations
  watchlist      Watchlist[]

  @@map("movies")
}

// ------------------------------------------------------------------------------
// 3. Watchlist Model (Composite Primary Key: userId + movieId)
// ------------------------------------------------------------------------------
model Watchlist {
  userId  String
  movieId String
  addedAt DateTime @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("watchlists")
}

// ------------------------------------------------------------------------------
// 4. Behind The Lens Model
// ------------------------------------------------------------------------------
model BehindTheLens {
  id            String   @id
  personName    String?
  role          String   @default("Filmmaker")
  title         String?
  details       String?  @db.Text
  filmography   String?  @db.Text
  videoUrl      String?
  thumbnailUrl  String?
  duration      String?  @default("3m 00s")
  filmmakerName String?
  cameraNote    String?  @db.Text
  clipUrl       String?
  createdAt     DateTime @default(now())

  @@map("behind_the_lens")
}

// ------------------------------------------------------------------------------
// 5. Film Submission Model & Status Enum
// ------------------------------------------------------------------------------
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model FilmSubmission {
  id           String           @id
  filmTitle    String
  directorName String
  email        String
  screenerLink String
  synopsis     String           @db.Text
  status       SubmissionStatus @default(PENDING)
  reason       String?          @db.Text
  reviewReason String?          @db.Text
  submittedAt  DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("film_submissions")
}

// ------------------------------------------------------------------------------
// 6. Pending Signup Model (Temporary OTP verification before user creation)
// ------------------------------------------------------------------------------
model PendingSignup {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  otp          String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("pending_signups")
}

// ------------------------------------------------------------------------------
// 7. Subscription Model (Current Active Subscription State per User)
// ------------------------------------------------------------------------------
model Subscription {
  id         String    @id @default(uuid())
  userId     String    @unique
  planName   String    @default("NONE") // "NONE" | "MONTHLY" | "YEARLY"
  amount     Int       @default(0) // 0, 99 or 999
  currency   String    @default("INR")
  status     String    @default("NOT_ACTIVE") // "ACTIVE" | "NOT_ACTIVE" | "EXPIRED"
  startDate  DateTime?
  expiryDate DateTime?
  updatedAt  DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ------------------------------------------------------------------------------
// 8. Subscription History Model (Complete Audit Trail of All Past & Current Subscriptions)
// ------------------------------------------------------------------------------
model SubscriptionHistory {
  id               String   @id @default(uuid())
  userId           String
  planName         String   // "MONTHLY" | "YEARLY"
  amount           Int      // 99 or 999
  status           String   // "ACTIVE" | "EXPIRED"
  paymentReference String?  // e.g. "DUMMY_TXN_..." or gateway transaction id
  startDate        DateTime
  expiryDate       DateTime
  createdAt        DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_history")
}


