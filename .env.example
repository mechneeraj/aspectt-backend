# ==============================================================================
# Aspectt OTT Backend Environment Configuration
# ==============================================================================

# Server Network Port
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Prisma format)
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/aspectt_ott?schema=public"
#"postgresql://postgres.impwlnfjtfskiiogyvld:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# JSON Web Token Secret & Expiry
JWT_SECRET="aspectt_dev_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins for Frontend Clients (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Brevo Transactional Email REST API Configuration
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
SENDER_EMAIL="your_verified_sender@domain.com"

